#uppgift 5, sök efter årtal
def sök_årtal(lista, år):
    resultat = [] #skapar en lista för resultaten

    for drama in lista: #går igenom skapade objekt från ovan
        if drama.Year == år:
            resultat.append(drama) #lägger till objektet i listan om true
    return resultat

